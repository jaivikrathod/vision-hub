# Copy to backend/.env and adjust. All values shown are the defaults.
# List values must be JSON, e.g. CORS_ORIGINS=["http://localhost:5173"]

LOG_LEVEL=INFO

# --- Storage (relative paths are resolved against backend/) ---
DATABASE_URL=sqlite:///database/app.db
# Later, for MySQL:  DATABASE_URL=mysql+pymysql://user:pass@localhost:3306/tracker  (pip install pymysql)
UPLOAD_DIR=uploads
PROCESSED_DIR=processed
MODEL_DIR=models
TEMP_DIR=tmp
MAX_UPLOAD_SIZE_MB=2048
MIN_FREE_DISK_MB=500

# --- Computer vision ---
DEFAULT_MODEL=yolo11n.pt
ALLOWED_MODELS=["yolo11n.pt","yolo11s.pt"]
# Download official weights into MODEL_DIR the first time a model is used.
ALLOW_MODEL_DOWNLOAD=true
DEFAULT_CONFIDENCE=0.40
DEFAULT_FRAME_SKIP=0
MAX_FRAME_SKIP=10
TRACKER_CONFIG=bytetrack.yaml
# auto | cpu | cuda | cuda:0 | mps
DEVICE=auto
INFERENCE_IMAGE_SIZE=640

# --- Visualization defaults ---
BOX_COLOR_BGR=[0,255,0]
SHOW_BOXES=true
SHOW_IDS=true
SHOW_CONFIDENCE=false

# --- Output encoding (H.264 via FFmpeg) ---
OUTPUT_CRF=23
OUTPUT_PRESET=veryfast
KEEP_AUDIO=true

# --- Background worker ---
MAX_CONCURRENT_JOBS=1

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
