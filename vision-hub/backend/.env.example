# Copy to backend/.env and adjust. All values shown are the defaults.
# List values must be JSON, e.g. CORS_ORIGINS=["http://localhost:5173"]

LOG_LEVEL=INFO

# --- Storage (relative paths are resolved against backend/) ---
DATABASE_URL=sqlite:///database/vision_hub.db
STORAGE_DIR=storage
MODEL_WEIGHTS_DIR=model_weights
MAX_UPLOAD_SIZE_MB=2048
MIN_FREE_DISK_MB=500

# --- Limits (CPU-friendly) ---
MAX_VIDEO_DURATION_SECONDS=600
# Frames taller than this are downscaled before inference.
MAX_INFERENCE_HEIGHT=1080
# Default age (days) used by the "clean up old results" action. 0 = keep forever.
RESULTS_RETENTION_DAYS=0

# --- Inference ---
# auto | cpu | cuda | cuda:0 | mps
DEVICE=auto
# PyTorch CPU threads used by the worker (default: CPU cores - 2)
# TORCH_THREADS=6
# Download official weights the first time a model is used.
ALLOW_MODEL_DOWNLOAD=true
# Neural-network models kept in memory at once (rule-based models don't count).
MAX_LOADED_MODELS=2
RESULT_CHUNK_SECONDS=10

# --- Output encoding (H.264 via FFmpeg) ---
OUTPUT_CRF=23
OUTPUT_PRESET=veryfast
KEEP_AUDIO=true

# --- Worker ---
WORKER_POLL_SECONDS=1.0
WORKER_STALE_SECONDS=60

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
